    <gazebo reference="laser_link">
     <!-- Visuals / Collisions omitted for this example -->
      <sensor type="ray" name="3d_laser_sensor">
        <!-- <visualize>true</visualize> -->
        <ray>
          <scan>
            <horizontal>
              <samples>1440</samples>
              <resolution>1</resolution>
              <!-- 下面是修改水平扫描范围，单位是弧度 -->
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>80</samples>
                <resolution>1</resolution>
                <min_angle>-0.122173</min_angle> <!-- -7° -->
                <max_angle>0.907571</max_angle>  <!-- 52° -->
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <!-- Using gazebo's noise instead of plugin's -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <!-- Using gazebo's update rate instead of plugin's -->
        <update_rate>30</update_rate>
        <plugin name="gazebo_ros_block_laser_controller" filename="libgazebo_ros_ray_sensor.so">
          <!-- Change namespace and output topic so published topic is /rrbot/laser/pointcloud -->
          <ros>
            <namespace>/rrbot/laser</namespace>
            <remapping>~/out:=pointcloud</remapping>
          </ros>
          <!-- Set output to sensor_msgs/PointCloud to get same output type as gazebo_ros_block_laser -->
          <output_type>sensor_msgs/PointCloud</output_type>
          <!-- <frame_name> ommited, will default to block_laser_link --><!-- min_intensity instead of hokuyoMinIntensity -->
          <min_intensity>100.0</min_intensity>
          <frame_name>laser_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="camera_link">
      <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <!-- <visualize>true</visualize> -->
       <update_rate>30.0</update_rate>
      <camera name="head">
        <!--匹配物理相机硬件上制造商提供的规格数据-->
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <!-- Noise is sampled independently per pixel on each frame.
               That pixel's noise value is added to each of its color
               channels, which at that point lie in the range [0,1]. -->
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>

     <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
      <ros>
        <!-- 命名空间设置 -->
        <namespace>/camera</namespace>
        <!-- 图像话题重映射 -->
        <remapping>image_raw:=image</remapping>
      </ros>
      <camera_name>camera</camera_name>
      <frame_name>camera_link</frame_name>
      <hack_baseline>0.07</hack_baseline>
      <always_on>true</always_on>
     </plugin>
     </sensor>
    </gazebo>

    <gazebo reference="camera_depth_link">
      <sensor type="depth" name="camera_sensor">
        <plugin name="depth_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>depth_camera</namespace>
            </ros>

            <!-- Set camera name. If empty, defaults to sensor name (i.e. "sensor_name") -->
            <camera_name>depth_camera</camera_name>

            <!-- Set TF frame name. If empty, defaults to link name (i.e. "link_name") -->
            <frame_name>camera_depth_link</frame_name>

            <hack_baseline>0.07</hack_baseline>

            <!-- No need to repeat distortion parameters or to set autoDistortion -->

            <min_depth>0.05</min_depth>
            <max_depth>8.0</max_depth>
        </plugin>
        <visualize>true</visualize>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera name="depth_camera">
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <!-- <k1>0.1</k1>
            <k2>0.2</k2>
            <k3>0.3</k3>
            <p1>0.4</p1>
            <p2>0.5</p2> -->
            <center>0.5 0.5</center>
          </distortion>
          </camera>
      </sensor>
    </gazebo>


<?xml version="1.0"?>
<sdf version="1.7">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <model name="hello_model">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- 关键部分：加载插件 -->
      <plugin name="hello_plugin" filename="libhello_plugin.so" />
    </model>
  </world>
</sdf>
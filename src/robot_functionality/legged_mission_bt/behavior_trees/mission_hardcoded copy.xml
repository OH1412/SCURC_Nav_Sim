<?xml version="1.0" encoding="UTF-8"?>
<!--
  硬编码任务 BT — 两物体抓取→放置，含中间航点

  物体A: 抓取点0 → 放置点8
  物体B: 抓取点1 → 放置点9

  航点:    mission_hardcoded.yaml
  机械臂:  arm_points.yaml (map_target → arm_pose_broadcaster 变换到 base_link)
-->
<root BTCPP_format="4">
  <BehaviorTree ID="MissionHardcoded">
    <Sequence name="HardcodedMission">

      <!-- ===== 抓取: 物体A (arm_point 0) ===== -->
      <Nav2PoseNode wp_id="wp1_pick1"/>
      <ArmPickNode arm_point_id="0" timeout="30.0"/>

       <!-- step 3: path=1 wp=2 state=1 (transit) target_id=-1 -->
      <Nav2PoseNode wp_id="nav_p1_wp2"/>

      <!-- step 4: path=1 wp=3 state=1 (transit) target_id=-1 -->
      <Nav2PoseNode wp_id="nav_p1_wp3"/>

      <!-- step 5: path=2 wp=2 state=3 (place) target_id=0 -->
      <Nav2PoseNode wp_id="nav_p2_wp2"/>
      <ArmPlaceNode arm_point_id="0" timeout="30.0"/>

    </Sequence>
  </BehaviorTree>
</root>

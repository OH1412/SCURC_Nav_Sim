<!--
  机械臂抓取任务导航行为树 (无 SubTree 版本)
  ==============================================
  流程:
    1. 导航到 waypoint 1: (1.35, -0.85)
    2. 导航到 waypoint 2: (1.925, -0.85)
    3. 机械臂抓取 map(1.925, 1.275, 0.25)
    4. 等待 10s
    5. 导航到 waypoint 3: (5.25, -0.85)

  所有逻辑内联，避免 SubTree 黑板隔离问题。
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <Sequence name="ArmGraspMission">

      <!-- ================================================================= -->
      <!-- Step 1: 导航到 waypoint 1 (1.35, -0.85) -->
      <!-- ================================================================= -->
      <SetPoseStamped x="1.35" y="0.0" z="0.0" yaw="0.0" pose="{goal}"/>
      <RecoveryNode number_of_retries="3" name="NavWp1">
        <PipelineSequence name="NavWp1Pipe">
          <RateController hz="1.0">
            <RecoveryNode number_of_retries="1" name="PlanWp1">
              <Sequence>
                <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{smoothed_path}"/>
              </Sequence>
              <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
            </RecoveryNode>
          </RateController>
          <RecoveryNode number_of_retries="1" name="FollowWp1">
            <FollowPath path="{smoothed_path}" controller_id="FollowPath"/>
            <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
          </RecoveryNode>
        </PipelineSequence>
        <ReactiveFallback>
          <GoalUpdated/>
          <RoundRobin/>
        </ReactiveFallback>
      </RecoveryNode>

      <!-- ================================================================= -->
      <!-- Step 2: 导航到 waypoint 2 (1.925, -0.85) -->
      <!-- ================================================================= -->
      <SetPoseStamped x="1.925" y="0.0" z="0.0" yaw="0.0" pose="{goal}"/>
      <RecoveryNode number_of_retries="3" name="NavWp2">
        <PipelineSequence name="NavWp2Pipe">
          <RateController hz="1.0">
            <RecoveryNode number_of_retries="1" name="PlanWp2">
              <Sequence>
                <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{smoothed_path}"/>
              </Sequence>
              <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
            </RecoveryNode>
          </RateController>
          <RecoveryNode number_of_retries="1" name="FollowWp2">
            <FollowPath path="{smoothed_path}" controller_id="FollowPath"/>
            <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
          </RecoveryNode>
        </PipelineSequence>
        <ReactiveFallback>
          <GoalUpdated/>
          <RoundRobin/>
        </ReactiveFallback>
      </RecoveryNode>

      <!-- ================================================================= -->
      <!-- Step 3: 机械臂抓取 map(1.925, 1.275, 0.25) -->
      <!-- ================================================================= -->
      <SetPoseStamped x="1.925" y="-0.425" z="0.25" yaw="0.0" pose="{arm_grasp_target}"/>
      <ArmControl target_pose="{arm_grasp_target}"
                  server_name="arm_control"
                  server_timeout="30000"/>

      <!-- ================================================================= -->
      <!-- Step 4: 等待 10 秒 -->
      <!-- ================================================================= -->
      <Wait wait_duration="10.0" server_name="wait" server_timeout="15"/>

      <!-- ================================================================= -->
      <!-- Step 5: 导航到 waypoint 3 (5.25, -0.85) -->
      <!-- ================================================================= -->
      <SetPoseStamped x="5.25" y="0.0" z="0.0" yaw="0.0" pose="{goal}"/>
      <RecoveryNode number_of_retries="3" name="NavWp3">
        <PipelineSequence name="NavWp3Pipe">
          <RateController hz="1.0">
            <RecoveryNode number_of_retries="1" name="PlanWp3">
              <Sequence>
                <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{smoothed_path}"/>
              </Sequence>
              <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
            </RecoveryNode>
          </RateController>
          <RecoveryNode number_of_retries="1" name="FollowWp3">
            <FollowPath path="{smoothed_path}" controller_id="FollowPath"/>
            <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
          </RecoveryNode>
        </PipelineSequence>
        <ReactiveFallback>
          <GoalUpdated/>
          <RoundRobin/>
        </ReactiveFallback>
      </RecoveryNode>

    </Sequence>
  </BehaviorTree>
</root>

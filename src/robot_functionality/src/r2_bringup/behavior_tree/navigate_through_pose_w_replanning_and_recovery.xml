<root main_tree_to_execute="MainTree">

  <!-- ================= 节点模型（Groot & 校验） ================= -->
  <TreeNodesModel>

    <!-- ===== 自定义高度控制节点 ===== -->
    <!-- <HeightControlAction>
      <InputPort name="target_height" type="double"/>
      <OutputPort name="height_reached" type="bool"/>
    </HeightControlAction> -->

    <!-- ===== Nav2 标准节点（保持原有） ===== -->
    <RecoveryNode>
      <Parameter name="number_of_retries" type="int"/>
      <Parameter name="name" type="string"/>
    </RecoveryNode>

    <PipelineSequence>
      <Parameter name="name" type="string"/>
    </PipelineSequence>

    <RateController>
      <Parameter name="hz" type="double"/>
    </RateController>

    <Fallback/>
    <ReactiveSequence/>
    <Inverter/>
    <Sequence/>
    <ReactiveFallback/>
    <RoundRobin/>

    <PathExpiringTimer>
      <Parameter name="seconds" type="double"/>
      <InputPort name="path" type="Path"/>
    </PathExpiringTimer>

    <IsPathValid>
      <InputPort name="path" type="Path"/>
    </IsPathValid>

    <GoalUpdated>
      <OutputPort name="new_goal" type="PoseStamped"/>
    </GoalUpdated>

    <ComputePathToPose>
      <InputPort name="goal" type="PoseStamped"/>
      <OutputPort name="path" type="Path"/>
      <Parameter name="planner_id" type="string"/>
    </ComputePathToPose>

    <FollowPath>
      <InputPort name="path" type="Path"/>
      <Parameter name="controller_id" type="string"/>
    </FollowPath>

    <ClearEntireCostmap>
      <Parameter name="service_name" type="string"/>
    </ClearEntireCostmap>

    <Spin>
      <Parameter name="spin_dist" type="double"/>
    </Spin>

    <BackUp>
      <Parameter name="backup_dist" type="double"/>
      <Parameter name="backup_speed" type="double"/>
    </BackUp>

    <Wait>
      <Parameter name="wait_duration" type="double"/>
    </Wait>

  </TreeNodesModel>

  <!-- ================= 主行为树 ================= -->
  <BehaviorTree ID="MainTree">

    <RecoveryNode number_of_retries="12" name="NavigateRecovery">

      <PipelineSequence name="NavigateWithReplanning">

        <!-- ===== 路径规划（保持原逻辑） ===== -->
        <RateController hz="2.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Fallback>
              <ReactiveSequence>
                <Inverter>
                  <PathExpiringTimer seconds="1" path="{path}"/>
                </Inverter>
                <IsPathValid path="{path}"/>
              </ReactiveSequence>
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            </Fallback>

            <Sequence>
              <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </RateController>

        <!-- ===== 控制阶段：高度 + 跟踪 ===== -->
        <RecoveryNode number_of_retries="1" name="FollowPath">

          <!-- ⭐ 关键：高度控制在 FollowPath 前 -->
          <Sequence name="HeightAdjustedFollow">
            <!-- <HeightControlAction target_height="0.3"/> -->
            <FollowPath path="{path}" controller_id="FollowPath"/>
          </Sequence>

          <Sequence>
            <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>

        </RecoveryNode>

      </PipelineSequence>

      <!-- ===== 恢复行为 ===== -->
      <ReactiveFallback>
        <GoalUpdated/>
        <RoundRobin>
          <Sequence>
            <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="0.785"/>
          <BackUp backup_dist="0.1" backup_speed="0.2"/>
          <Wait wait_duration="1"/>
        </RoundRobin>
      </ReactiveFallback>

    </RecoveryNode>

  </BehaviorTree>
</root>

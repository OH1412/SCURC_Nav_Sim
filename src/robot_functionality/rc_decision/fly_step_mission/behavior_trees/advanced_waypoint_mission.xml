<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="advanced_waypoint_mission">
    <Sequence name="AdvancedWaypointMission">
      
      <!-- 1. 路径生成：根据输入的主航点生成完整路径（包括过渡航点） -->
      <PathGeneratorNode 
        main_waypoints="[-1,2]" 
        waypoints_file="/home/oh/SCURC_Nav_Sim/src/robot_functionality/rc_decision/fly_step_mission/config/waypoints.yaml" />
      
      <!-- 2. 处理路径中的每个航点 -->
      <Sequence name="ProcessWaypoint_-1">
        <!-- 导航到-1号航点 -->
        <Nav2PoseNode 
          frame_id="map"
          x="-1.75"
          y="-0.15"
          yaw="1.57" />
        
        <!-- 检查并记录任务 -->
        <WaypointTaskExecutorNode 
          current_waypoint_id="-1"
          waypoint_task_map="{waypoint_task_map}" />
      </Sequence>
      
      <Sequence name="ProcessWaypoint_-1_front">
        <!-- 导航到-1_front过渡点 -->
        <Nav2PoseNode 
          frame_id="map"
          x="-1.75"
          y="0.35"
          yaw="1.57" />
        
        <!-- 检查是否有立即执行的任务 -->
        <WaypointTaskExecutorNode 
          current_waypoint_id="-1_front"
          waypoint_task_map="{waypoint_task_map}" />
        
        <!-- 立即执行上升任务（如果有） -->
        <Fallback name="ExecuteImmediateTask">
          <Sequence name="ExecuteImmediateAscend">
            <CheckAscendRequired task_type="{task_type}" />
            <AscendNode
              z_target="{target_ascend_height}"
              z_speed="{ascend_speed}"
              max_duration="{ascend_max_duration}" />
          </Sequence>
          
          <AlwaysSuccess />
        </Fallback>
        
        <!-- 检查是否有延迟任务需要在此航点执行（来自前一个航点的标记） -->
        <DelayedTaskExecutorNode 
          requires_next_waypoint_task="{requires_next_waypoint_task}"
          next_waypoint_task_type="{next_waypoint_task_type}" />
        
        <!-- 执行任何标记的延迟任务 -->
        <Fallback name="ExecutePendingTask">
          <Sequence name="ExecutePendingDescend">
            <CheckDescendRequired task_type="{executed_task_type}" />
            <DescendNode
              z_target="{target_descend_height}"
              z_speed="{descend_speed}"
              max_duration="{descend_max_duration}" />
          </Sequence>
          
          <AlwaysSuccess />
        </Fallback>
      </Sequence>
      
      <Sequence name="ProcessWaypoint_2">
        <!-- 导航到2号航点 -->
        <Nav2PoseNode 
          frame_id="map"
          x="-1.75"
          y="1.05"
          yaw="1.57" />
        
        <!-- 检查并记录任务 -->
        <WaypointTaskExecutorNode 
          current_waypoint_id="2"
          waypoint_task_map="{waypoint_task_map}" />
      </Sequence>
      
      <Sequence name="ProcessWaypoint_2_front">
        <!-- 导航到2_front过渡点 -->
        <Nav2PoseNode 
          frame_id="map"
          x="-1.75"
          y="1.55"
          yaw="1.57" />
        
        <!-- 检查是否有立即执行的任务 -->
        <WaypointTaskExecutorNode 
          current_waypoint_id="2_front"
          waypoint_task_map="{waypoint_task_map}" />
        
        <!-- 立即执行上升任务（如果有） -->
        <Fallback name="ExecuteImmediateTask2">
          <Sequence name="ExecuteImmediateAscend2">
            <CheckAscendRequired task_type="{task_type}" />
            <AscendNode
              z_target="{target_ascend_height}"
              z_speed="{ascend_speed}"
              max_duration="{ascend_max_duration}" />
          </Sequence>
          
          <AlwaysSuccess />
        </Fallback>
        
        <!-- 检查是否有延迟任务需要在此航点执行（来自前一个航点的标记） -->
        <DelayedTaskExecutorNode 
          requires_next_waypoint_task="{requires_next_waypoint_task}"
          next_waypoint_task_type="{next_waypoint_task_type}" />
        
        <!-- 执行任何标记的延迟任务 -->
        <Fallback name="ExecutePendingTask2">
          <Sequence name="ExecutePendingDescend2">
            <CheckDescendRequired task_type="{executed_task_type}" />
            <DescendNode
              z_target="{target_descend_height}"
              z_speed="{descend_speed}"
              max_duration="{descend_max_duration}" />
          </Sequence>
          
          <AlwaysSuccess />
        </Fallback>
      </Sequence>
      
    </Sequence>
  </BehaviorTree>
</root>